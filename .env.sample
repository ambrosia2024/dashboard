DJANGO_SECRET_KEY=your_django_secret

# Shared defaults used by both local runs and Docker.
# Optional overlays:
# - .env.local   for `python manage.py runserver`
# - .env.docker  for Docker / compose

POSTGRES_DB=ambrosia
POSTGRES_USER=amb_admin
POSTGRES_PASSWORD=password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=youremail@domain.com
PGADMIN_DEFAULT_PASSWORD=password

CROP_ONTO_CONNECT_TIMEOUT=5
READ_TIMEOUT=45

SKIP_CROP_FETCH=0

SCIO_VOCAB_API_BASE
SCIO_NUTS_API_BASE
SCIO_MODELS_API_URL
SCIO_TOXIN_QUERY_URL
SCIO_TOXIN_SYNC_CHUNK_DAYS=7
SCIO_TOXIN_SYNC_REQUEST_DELAY_SECONDS=2
SCIO_TOXIN_SYNC_CHUNK_MAX_RETRIES=2
SCIO_TOXIN_SYNC_MAX_CONSECUTIVE_FAILURES=5

# Celery background jobs
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Authentication hardening
PUBLIC_SIGNUP_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
LOGIN_BURST_LIMIT_PER_MINUTE=20
SECURE_HSTS_SECONDS=31536000
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Ambra (Serverless API)
SCW_AI_BASE_URL=
SCW_SECRET_KEY=
SCW_AI_MODEL=qwen3.5-397b-a17b
# "none" disables the model\'s hidden reasoning phase (big TTFT win).
# Use low/medium/high only if answers need more depth.
SCW_AI_REASONING_EFFORT=none
SCW_AI_MAX_TOKENS=1024
SCW_AI_MAX_USER_CHARS=1000
SCW_AI_TEMPERATURE=0.6
SCW_AI_TOP_P=0.95
SCW_AI_PRESENCE_PENALTY=0
SCW_AI_TIMEOUT_SECONDS=180

# Set this only in .env.docker when running inside containers.
# RUNNING_IN_DOCKER=true

# --- Email (Postmark) ---
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
DEFAULT_FROM_EMAIL=Ambrosia Dashboard <noreply@ambrosia-project.eu>
EMAIL_REPLY_TO=
